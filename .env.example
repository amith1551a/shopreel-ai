# Browser CPU mode needs NO API keys and does not read .env.
# The settings below are ONLY for the preserved legacy Python/Runway studio.
# Do not enable the paid legacy provider for browser-only rendering.
# Copy only if using legacy mode; never put actual keys in browser code or Git.
RUNWAYML_API_SECRET=replace_with_your_runway_developer_api_key
# USD limit for each initial confirmation or individual-scene retry, not a lifetime budget.
SHOPREEL_MAX_GENERATION_USD=1.00

# Higgsfield AI Integration (Server-side only, never expose in frontend)
# To use Higgsfield AI features:
# 1. Register at https://www.higgsfield.ai/
# 2. Create API credentials in your dashboard
# 3. Install the official Higgsfield SDK: pip install higgsfield-client
# 4. Set HF_CREDENTIALS in .env.local (format: key_id:key_secret)

# HF_CREDENTIALS format: key_id:key_secret (NEVER commit)
HF_CREDENTIALS=replace_with_your_higgsfield_key_id:replace_with_your_higgsfield_key_secret

# Budget guard settings (cents, America/Chicago timezone)
HF_MONTHLY_BUDGET_CENTS=2000
HF_DAILY_BUDGET_CENTS=60
HF_JOB_BUDGET_CENTS=25
HF_CONCURRENT_PAID_JOBS=1

