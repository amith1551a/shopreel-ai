{
  "name": "shopreel-browser-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5050 --strictPort",
    "dev:server": "node --watch backend/index.mjs",
    "postinstall": "node hostinger-prebuild.mjs",
    "prebuild": "node hostinger-prebuild.mjs",
    "build": "npm run prebuild && tsc -b && vite build && node build-assets.mjs",
    "build:backend": "echo 'Backend uses native .mjs (no compilation needed)'",
    "start": "node server.mjs",
    "start:legacy": "python app.py",
    "preview": "node server.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:parity": "node test-parity/run-tests.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "1.65.1",
    "express": "4.21.2",
    "dotenv": "16.4.7",
    "sharp": "0.34.2",
    "busboy": "1.3.0",
    "moment-timezone": "^0.5.46",
    "async-lock": "1.4.1",
    "h264-mp4-encoder": "1.0.12",
    "mediabunny": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
