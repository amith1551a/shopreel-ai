# NPM Configuration for ShopReel AI
# Ensures build-time dependencies are always installed

# Include devDependencies in npm install
# Critical for Hostinger deployments where build and install happen in the same environment
# Note: 'include-dev' is deprecated; use this approach in postinstall hook instead
# See: hostinger-prebuild.mjs for the actual implementation

# Prefer offline mode if packages are already cached
prefer-offline=true

# Use exact versions from package-lock.json
save-exact=true

# Reduce npm output verbosity in CI environments
loglevel=warn
